diff --git a/spa/plugins/bluez5/a2dp-codec-ssc.c b/spa/plugins/bluez5/a2dp-codec-ssc.c
new file mode 100644
index 0000000..20a741a
--- /dev/null
+++ b/spa/plugins/bluez5/a2dp-codec-ssc.c
@@ -0,0 +1,244 @@
+/* Samsung Scalable / Seamless Codec A2DP source plugin.
+ * SPDX-License-Identifier: MIT
+ * Encoder implementation: samsung-ssc-encoder, BSD-3-Clause.
+ */
+
+#include <errno.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <arpa/inet.h>
+
+#include <spa/param/audio/format.h>
+#include <spa/param/audio/format-utils.h>
+#include <spa/utils/string.h>
+
+#include "rtp.h"
+#include "media-codecs.h"
+#include "ssc_encoder.h"
+
+#define SSC_VENDOR_ID 0x00000075u
+#define SSC_CODEC_ID  0x0103u
+#define SSC_CAPS_ALL  0x3eu
+#define SSC_FLAG_44K1 0x20u
+#define SSC_FLAG_48K   0x10u
+#define SSC_FLAG_HIFI  0x04u
+#define SSC_FLAG_UHQ   0x02u
+
+typedef struct __attribute__((packed)) {
+	a2dp_vendor_codec_t info;
+	uint8_t flags;
+} a2dp_ssc_t;
+
+struct impl {
+	ssc_encoder *encoder;
+	struct rtp_header *header;
+	uint8_t flags;
+	uint32_t rate;
+	uint32_t bits;
+	uint32_t bitrate;
+	int block_size;
+	uint64_t interval;
+};
+
+static int codec_fill_caps(const struct media_codec *codec, uint32_t flags,
+		const struct spa_dict *settings, uint8_t caps[A2DP_MAX_CAPS_SIZE])
+{
+	a2dp_ssc_t conf = { .info = { SSC_VENDOR_ID, SSC_CODEC_ID }, .flags = SSC_CAPS_ALL };
+	memcpy(caps, &conf, sizeof(conf));
+	return sizeof(conf);
+}
+
+static int codec_select_config(const struct media_codec *codec, uint32_t flags,
+		const void *caps, size_t caps_size,
+		const struct media_codec_audio_info *audio,
+		const struct spa_dict *settings, uint8_t config[A2DP_MAX_CAPS_SIZE],
+		void **config_data)
+{
+	a2dp_ssc_t conf;
+	const a2dp_ssc_t *peer = caps;
+	if (caps == NULL || caps_size < sizeof(conf) ||
+	    peer->info.vendor_id != SSC_VENDOR_ID || peer->info.codec_id != SSC_CODEC_ID)
+		return -EINVAL;
+
+	/* Prefer 96 kHz UHQ when the sink advertises it, then 48 kHz HiFi.
+	 * Keep SSC 16-bit modes available for sinks without the newer modes. */
+	conf.info = peer->info;
+	if ((peer->flags & SSC_FLAG_UHQ) && !(peer->flags & 0x01))
+		conf.flags = SSC_FLAG_UHQ | (peer->flags & 0x08);
+	else if (peer->flags & SSC_FLAG_HIFI)
+		conf.flags = SSC_FLAG_HIFI | (peer->flags & 0x08);
+	else if (peer->flags & SSC_FLAG_48K)
+		conf.flags = SSC_FLAG_48K | (peer->flags & 0x08);
+	else if (peer->flags & SSC_FLAG_44K1)
+		conf.flags = SSC_FLAG_44K1 | (peer->flags & 0x08);
+	else
+		return -ENOTSUP;
+	memcpy(config, &conf, sizeof(conf));
+	return sizeof(conf);
+}
+
+static int codec_validate_config(const struct media_codec *codec, uint32_t flags,
+		const void *caps, size_t caps_size, struct spa_audio_info *info)
+{
+	const a2dp_ssc_t *conf = caps;
+	if (!conf || caps_size < sizeof(*conf) || conf->info.vendor_id != SSC_VENDOR_ID ||
+	    conf->info.codec_id != SSC_CODEC_ID)
+		return -EINVAL;
+	spa_zero(*info);
+	info->media_type = SPA_MEDIA_TYPE_audio;
+	info->media_subtype = SPA_MEDIA_SUBTYPE_raw;
+	info->info.raw.channels = 2;
+	info->info.raw.position[0] = SPA_AUDIO_CHANNEL_FL;
+	info->info.raw.position[1] = SPA_AUDIO_CHANNEL_FR;
+	if (conf->flags & SSC_FLAG_UHQ) {
+		info->info.raw.rate = 96000;
+		info->info.raw.format = SPA_AUDIO_FORMAT_S24_32_LE;
+	} else if (conf->flags & SSC_FLAG_HIFI) {
+		info->info.raw.rate = 48000;
+		info->info.raw.format = SPA_AUDIO_FORMAT_S24_32_LE;
+	} else if (conf->flags == SSC_FLAG_44K1 || conf->flags == (SSC_FLAG_44K1 | 0x08)) {
+		info->info.raw.rate = 44100;
+		info->info.raw.format = SPA_AUDIO_FORMAT_S16_LE;
+	} else if (conf->flags == SSC_FLAG_48K || conf->flags == (SSC_FLAG_48K | 0x08)) {
+		info->info.raw.rate = 48000;
+		info->info.raw.format = SPA_AUDIO_FORMAT_S16_LE;
+	} else {
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static int codec_enum_config(const struct media_codec *codec, uint32_t flags,
+		const void *caps, size_t caps_size, uint32_t id, uint32_t idx,
+		struct spa_pod_builder *b, struct spa_pod **param)
+{
+	struct spa_audio_info info;
+	struct spa_pod_frame f;
+	int res = codec_validate_config(codec, flags, caps, caps_size, &info);
+	if (res < 0 || idx > 0)
+		return res < 0 ? res : 0;
+	spa_pod_builder_push_object(b, &f, SPA_TYPE_OBJECT_Format, id);
+	spa_pod_builder_add(b,
+		SPA_FORMAT_mediaType, SPA_POD_Id(info.media_type),
+		SPA_FORMAT_mediaSubtype, SPA_POD_Id(info.media_subtype),
+		SPA_FORMAT_AUDIO_format, SPA_POD_Id(info.info.raw.format),
+		SPA_FORMAT_AUDIO_rate, SPA_POD_Int(info.info.raw.rate),
+		SPA_FORMAT_AUDIO_channels, SPA_POD_Int(info.info.raw.channels),
+		SPA_FORMAT_AUDIO_position, SPA_POD_Array(sizeof(uint32_t), SPA_TYPE_Id,
+			info.info.raw.channels, info.info.raw.position), 0);
+	*param = spa_pod_builder_pop(b, &f);
+	return *param ? 1 : -EIO;
+}
+
+static uint32_t choose_bitrate(uint32_t rate, size_t mtu)
+{
+	if (rate == 96000)
+		return mtu >= 700 ? 584000 : 291000;
+	return 192000;
+}
+
+static void *codec_init(const struct media_codec *codec, uint32_t flags,
+		void *config, size_t config_size, const struct spa_audio_info *info,
+		void *props, size_t mtu)
+{
+	struct impl *this;
+	const a2dp_ssc_t *conf = config;
+	this = calloc(1, sizeof(*this));
+	if (!this)
+		return NULL;
+	if (!conf || config_size < sizeof(*conf) || info->media_type != SPA_MEDIA_TYPE_audio ||
+	    info->media_subtype != SPA_MEDIA_SUBTYPE_raw || info->info.raw.channels != 2)
+		goto error;
+	this->flags = conf->flags;
+	this->rate = info->info.raw.rate;
+	this->bits = (info->info.raw.format == SPA_AUDIO_FORMAT_S16_LE) ? 16 : 24;
+	if ((this->bits == 16 && info->info.raw.format != SPA_AUDIO_FORMAT_S16_LE) ||
+	    (this->bits == 24 && info->info.raw.format != SPA_AUDIO_FORMAT_S24_32_LE))
+		goto error;
+	this->bitrate = choose_bitrate(this->rate, mtu);
+	if (this->rate != 96000 && !(this->flags & 0x08))
+		this->bitrate = 128000;
+	this->encoder = ssc_encoder_create(this->rate);
+	if (!this->encoder)
+		goto error;
+	this->block_size = 864 * 2 * (this->bits == 16 ? 2 : 4);
+	this->interval = (uint64_t)864 * SPA_NSEC_PER_SEC / this->rate;
+	return this;
+error:
+	ssc_encoder_destroy(this->encoder);
+	free(this);
+	return NULL;
+}
+
+static void codec_deinit(void *data)
+{
+	struct impl *this = data;
+	ssc_encoder_destroy(this->encoder);
+	free(this);
+}
+
+static int codec_get_block_size(void *data) { return ((struct impl *)data)->block_size; }
+static uint64_t codec_get_interval(void *data) { return ((struct impl *)data)->interval; }
+
+static int codec_start_encode(void *data, void *dst, size_t dst_size,
+		uint16_t seqnum, uint32_t timestamp)
+{
+	struct impl *this = data;
+	if (dst_size < sizeof(struct rtp_header))
+		return -ENOSPC;
+	this->header = dst;
+	this->header->v = 2;
+	this->header->pt = 96;
+	this->header->sequence_number = htons(seqnum);
+	this->header->timestamp = htonl(timestamp);
+	this->header->ssrc = htonl(1);
+	return sizeof(struct rtp_header);
+}
+
+static int codec_encode(void *data, const void *src, size_t src_size,
+		void *dst, size_t dst_size, size_t *dst_out, int *need_flush)
+{
+	struct impl *this = data;
+	int res;
+	if (!src || src_size < (size_t)this->block_size)
+		return -EINVAL;
+	if (this->bits == 16)
+		res = ssc_encode(this->encoder, src, this->bitrate, 0, dst, dst_size);
+	else
+		res = ssc_encode_s32(this->encoder, src, 24, this->bitrate, 0, dst, dst_size);
+	if (res < 0)
+		return res;
+	*dst_out = (size_t)res;
+	*need_flush = NEED_FLUSH_ALL;
+	return this->block_size;
+}
+
+static void codec_get_delay(void *data, uint32_t *encoder, uint32_t *decoder)
+{
+	if (encoder) *encoder = 108;
+	if (decoder) *decoder = 0;
+}
+
+static const struct media_codec a2dp_codec_ssc = {
+	.id = SPA_BLUETOOTH_AUDIO_CODEC_SSC,
+	.kind = MEDIA_CODEC_A2DP,
+	.codec_id = A2DP_CODEC_VENDOR,
+	.vendor = { .vendor_id = SSC_VENDOR_ID, .codec_id = SSC_CODEC_ID },
+	.name = "ssc",
+	.description = "Samsung Seamless Codec",
+	.fill_caps = codec_fill_caps,
+	.select_config = codec_select_config,
+	.enum_config = codec_enum_config,
+	.validate_config = codec_validate_config,
+	.init = codec_init,
+	.deinit = codec_deinit,
+	.get_block_size = codec_get_block_size,
+	.get_interval = codec_get_interval,
+	.start_encode = codec_start_encode,
+	.encode = codec_encode,
+	.get_delay = codec_get_delay,
+};
+
+MEDIA_CODEC_EXPORT_DEF("ssc", &a2dp_codec_ssc);
